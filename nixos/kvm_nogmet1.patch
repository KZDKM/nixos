 	/* not applicable to AMD; but clean them to prevent any fall out */
 	pmu->counter_bitmask[KVM_PMC_FIXED] = 0;
 	pmu->nr_arch_fixed_counters = 0;
+
+	/* per-counter MSRs (PerfCtr-Core / PerfMonV2: 6 GP counters) */
+	for (int i = 0; i < pmu->nr_arch_gp_counters; i++) {
+	    svm_disable_intercept_for_msr(vcpu, MSR_F15H_PERF_CTL + 2 * i, MSR_TYPE_RW);
