+	}
+
+	/* legacy K7 aliases — same physical counters on modern CPUs */
+	for (int i = 0; i < AMD64_NUM_COUNTERS; i++) {
+	    svm_disable_intercept_for_msr(vcpu, MSR_K7_EVNTSEL0 + i, MSR_TYPE_RW);
+	    svm_disable_intercept_for_msr(vcpu, MSR_K7_PERFCTR0 + i, MSR_TYPE_RW);
+	}
+
+	/* PerfMonV2 globals — only passthrough if guest owns ALL counters,
+	 * otherwise host perf events on the same PMU get clobbered */
+	if (kvm_pmu_has_perf_global_ctrl(pmu) &&
+	    pmu->nr_arch_gp_counters == kvm_pmu_cap.num_counters_gp) {
+	    svm_disable_intercept_for_msr(vcpu, MSR_AMD64_PERF_CNTR_GLOBAL_CTL,        MSR_TYPE_RW);
+	    svm_disable_intercept_for_msr(vcpu, MSR_AMD64_PERF_CNTR_GLOBAL_STATUS,     MSR_TYPE_RW);
+	    svm_disable_intercept_for_msr(vcpu, MSR_AMD64_PERF_CNTR_GLOBAL_STATUS_CLR, MSR_TYPE_RW);
+	}
