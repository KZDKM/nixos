+static bool is_blocked_msr(u32 index)
+{
+    /* KVM paravirt range — entire 0x4B564D00..FF window */
+    if ((index & 0xFFFFFF00) == 0x4B564D00)
+        return true;
+
+    /* Hyper-V MSR range */
+    if (index >= 0x40000000 && index <= 0x4000FFFF)
+        return true;
+
+    /* KVM legacy clock synthetics */
+    if (index == 0x11 || index == 0x12)
+        return true;
+
+    /* AMD SVM control MSRs */
+    //if (index >= 0xC0010114 && index <= 0xC001011B)
+    //    return true;
+
+    /* AMD OSVW — fingerprints family/model */
+    //if (index == 0xC0010140 || index == 0xC0010141)
+    //    return true;
+
+    return false;
+}
+
+static bool spoof_msr_write(struct kvm_vcpu *vcpu, u32 index, u64 data)
+{
+    switch (index) {
+    case 0xC0010015:
+    case 0xC0010010:
+    case 0xC0011029:
+    case 0xC0011020:
+        /* Silently accept writes but don't actually apply them */
+        return true;
+    case 0x00000277:
+        /* guest legitimately configures this */
+        return false;
+    }
+    return false;
