diff --git a/arch/x86/kvm/svm/vmenter.S b/arch/x86/kvm/svm/vmenter.S
index d47c5c93c991..5db0e284f862 100644
--- a/arch/x86/kvm/svm/vmenter.S
+++ b/arch/x86/kvm/svm/vmenter.S
@@ -204,6 +204,20 @@ SYM_FUNC_START(__svm_vcpu_run)
 	/* Pop @svm to RAX while it's the only available register. */
 	pop %_ASM_AX
 
+	/* immediate rdtsc save */
+	push %r12
+	push %_ASM_DX
+
+	mov %_ASM_AX, %r12           /* r12 = svm pointer (base for offset) */
+	rdtsc
+	shl $32, %rdx
+	or %rdx, %rax                /* rax = full 64-bit TSC */
+	mov %rax, SVM_exit_tsc(%r12) /* vcpu->arch.exit_tsc = TSC */
+	mov %r12, %_ASM_AX
+
+	pop %_ASM_DX
+	pop %r12
+
 	/* Save all guest registers.  */
 	mov %_ASM_CX,   VCPU_RCX(%_ASM_AX)
 	mov %_ASM_DX,   VCPU_RDX(%_ASM_AX)
