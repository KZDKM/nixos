// macbook specific, included from config.kdl

input {
	touchpad {
		natural-scroll
		click-method "clickfinger"
		dwt
		accel-speed 0.333
		accel-profile "flat"
	}
	keyboard {
        xkb {
            options "ctrl:swapcaps"
        }
	}
}

// built-in display, check the name with `niri msg outputs`
output "eDP-1" {
	scale 1.49
	variable-refresh-rate
}
