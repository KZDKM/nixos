// desktop specific, included from config.kdl

output "Invalid Vendor Codename - RTK RTK QHD HDR 0x01010101" {
	transform "270"
	position x=-900 y=-220
	mode "2560x1600@99.999"
	scale 1.4
	layout {
		default-column-width { proportion 1.0; }
	}
}

output "PNP(AOC) Q27G3XMN 1APQ7JA003861" {
	focus-at-startup
	variable-refresh-rate on-demand=true
	mode "2560x1440@170.002"
	position x=0 y=0
}

output "ASUSTek COMPUTER INC XG27ACMES W4LMTF186288 " {
	focus-at-startup
	variable-refresh-rate on-demand=true
	mode "2560x1440@239.970"
	position x=0 y=0
}

output "ViewSonic Corporation VX2719-2K-PRO VZC204000021" {
    transform "90"
	mode "2560x1440@165.003"
    position x=-1440 y=-500
}

output "Samsung Electric Company SAMSUNG 0x01000E00" {
	mode "4096x2160@60.000"
	scale 1.5

}

window-rule {
    match app-id="looking-glass-client"
    open-fullscreen true
    block-out-from "screencast"
    open-on-output "PNP(AOC) Q27G3XMN 1APQ7JA003861"
}

// VRR windows
window-rule {
	match app-id=r#"^(steam_app_)(.*)$"#
	match app-id="cs2"
    match app-id="looking-glass-client"
	match title="Ready Or Not"
	match title="memflow mirror"
	variable-refresh-rate true
	//allow-tearing true
}

debug {
	render-drm-device "/dev/dri/renderD128"
}
