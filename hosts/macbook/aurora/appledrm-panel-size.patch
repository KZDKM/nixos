omacom/linux-aurora#84: the built-in panel reports 0x0 mm to userspace, so
GDM/mutter and the cursor stay at 1x. The EDID update with no EDID (internal
panel) resets display_info; put the size the modes carry back afterwards.
Fix from the issue, tested there on the release kernel.

--- a/drivers/gpu/drm/apple/iomfb.c
+++ b/drivers/gpu/drm/apple/iomfb.c
@@ -721,6 +721,20 @@
 	}
 
 	/*
+	 * Without an EDID (an internal panel), the EDID update above also reset
+	 * the physical size. Put back what the modes carry: the size DCP reported
+	 * or, failing that, the panel node's width-mm/height-mm.
+	 */
+	if (count && !connector->display_info.width_mm) {
+		mutex_lock(&dcp->modes_lock);
+		if (dcp->nr_modes) {
+			connector->display_info.width_mm = dcp->modes[0].mode.width_mm;
+			connector->display_info.height_mm = dcp->modes[0].mode.height_mm;
+		}
+		mutex_unlock(&dcp->modes_lock);
+	}
+
+	/*
 	 * An internal panel has no EDID, so nothing fills in the refresh range
 	 * that userspace needs before it will drive VRR. Supply the range DCP
 	 * reported for the mode. This has to follow the EDID update, which
